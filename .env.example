# Copy this file to .env and fill in the keys. Never commit .env.

# ElevenLabs: the free plan works (elevenlabs.io -> profile -> API Keys). The coupon adds credits later.
# If ElevenLabs fails or runs out, Townie switches to a free Edge voice automatically.
ELEVENLABS_API_KEY=
WHISPER_VOICE_ID=EXAVITQu4vr4xnSDxMaL
TTS_MODEL=eleven_flash_v2_5
STT_MODEL=scribe_v2
BACKUP_VOICE=en-CA-ClaraNeural
# 1.0 is normal speed; lower is slower and calmer (0.7 to 1.2)
VOICE_SPEED=0.9

# Language models. Townie uses every provider that has a key, in this order.
# To switch to Featherless later: paste its key and set LLM_ORDER=featherless,groq
LLM_ORDER=gemini,groq,featherless

# Groq: free, no card (console.groq.com -> API Keys). Also powers web-app speech-to-text as a backup.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b

# Featherless AI (once the LarpHacks promo code works)
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen2.5-72B-Instruct
FEATHERLESS_FALLBACK_MODEL=Qwen/Qwen2.5-7B-Instruct

# Google Gemini: free, broad knowledge (aistudio.google.com -> Get API key). Used first when set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenStreetMap needs a descriptive User-Agent with a contact email
OSM_USER_AGENT=Townie/1.0 (+https://github.com/jeremyrd18/townie)

# Indoor demo location (the venue). Defaults to Union Station.
DEMO_LAT=43.6453
DEMO_LON=-79.3806
DEMO_NAME=Venue

# Optional: Render Workflows for Prep mode (Account Settings -> API Keys; slug = workflow service name)
RENDER_API_KEY=
WORKFLOW_SLUG=townie-prep

# Optional: Agentboxd inbox (free Builder plan with code LARPHACKS-2026)
AGENTBOXD_API_KEY=
AGENTBOXD_USERNAME=townie-larphacks
